# Copy to .env.local (chmod 600). scripts/serve.sh loads it.
REVET_COOKIE_KEY=                  # openssl rand -hex 32
DURIN_AUTH_HOST=auth.example.com   # the sign-in host, and the passkey RP ID
#DURIN_SUFFIX=example.com          # app hosts are *.<suffix>; default: DURIN_AUTH_HOST minus its first label
DURIN_SETUP_CODE=                  # makes an owner while there is none; ignored otherwise, so delete it afterwards
#DURIN_PROXY=forwarded             # forwarded (Caddy, Traefik) or original (nginx); see docs/proxies.md
#DURIN_USER_HEADER=Remote-User     # header verify answers with the account name
#DURIN_IDLE_SECONDS=300            # a sign-in without "remember me" ends after this much quiet
#DURIN_MAX_SECONDS=43200           # ... and after this long in any case
#DURIN_REMEMBER_SECONDS=2592000    # "remember me" lasts this long
#REVET_BIND=127.0.0.1
#REVET_TRUSTED_PROXIES=127.0.0.1,::1  # only these peers' forwarding headers are believed
